# ==============================================================================
# Apna Campus - Monorepo Root Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' at the repository root:
#    cp .env.example .env
# 2. Or configure individual .env files in backend/ and frontend/ directories.
# ==============================================================================

# Backend Server Port (Default: 4000)
PORT=4000

# Environment Mode: development | production | test
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret & Expiration
# REQUIRED: Replace with a secure random string (min 32 characters) in production
JWT_SECRET=development-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=8h

# PostgreSQL Connection URL for Prisma ORM
# REQUIRED: Configure your local PostgreSQL username, password, and database name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_management?schema=public

# Frontend API Base URL (used by Vite frontend)
VITE_API_URL=http://localhost:4000/api

# Optional: Google Gemini AI API Key for Chatbot (leave empty for deterministic campus engine fallback)
GEMINI_API_KEY=
