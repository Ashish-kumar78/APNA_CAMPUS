# ==============================================================================
# Apna Campus - Backend Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the backend/ directory:
#    cp .env.example .env
# 2. Update the values below to match your local development environment.
# ==============================================================================

# Server Port (Default: 4000)
PORT=4000

# Environment Mode: development | production | test
NODE_ENV=development

# Allowed Frontend Client Origin for CORS (Default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret & Token Expiration
# REQUIRED: Replace with a secure random string (min 32 characters) in production
JWT_SECRET=development-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=8h

# PostgreSQL Connection URL for Prisma ORM
# REQUIRED: Replace postgres:postgres with your local PostgreSQL username and password.
# Replace college_management with your local database name.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_management?schema=public

# Optional: Google Gemini AI API Key for Chatbot (leave empty for deterministic campus engine fallback)
GEMINI_API_KEY=
