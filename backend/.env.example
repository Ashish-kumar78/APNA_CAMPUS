# ==============================================================================
# Apna Campus - Backend Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the backend/ directory:
#    cp .env.example .env
# 2. Update the values below to match your local development environment.
# ==============================================================================

# Server Port (Default: 4000)
PORT=4000

# Environment Mode: development | production | test
NODE_ENV=development

# Allowed Frontend Client Origin for CORS (Default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret & Token Expiration
# REQUIRED: Replace with a secure random string (min 32 characters) in production
# Generate privately for each environment (for example: openssl rand -base64 48).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# MongoDB Atlas connection string for Prisma ORM.
# Create a least-privilege Atlas database user and allow this app's network/IP in Atlas.
# Put the real URI only in backend/.env or the deployment secret manager; never commit it.
# Example format (replace all placeholders):
# mongodb+srv://<db_user>:<db_password>@<cluster-host>/apna_campus?retryWrites=true&w=majority
DATABASE_URL=

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_CONFIDENCE_THRESHOLD=0.65

# Optional: Google Gemini AI API Key for Chatbot (leave empty for deterministic campus engine fallback)
GEMINI_API_KEY=

# Optional FastAPI complaint-classification service (local development default)
AI_SERVICE_URL=http://localhost:8000

# Demo seed safety. The seed script refuses to run unless all local-only
# conditions are met; never enable this for Atlas shared/production databases.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=
