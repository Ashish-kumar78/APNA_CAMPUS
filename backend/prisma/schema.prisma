    datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  MANAGEMENT
  PRINCIPAL
  ADMIN
  HOD
  FACULTY
  STUDENT
  EXAM_CELL
  ACCOUNTS
  LIBRARY
  PLACEMENT
  SCHOLARSHIP
  TRANSPORT
  HOSTEL
  STAFF
  WARDEN
  CANTEEN
  ADMISSIONS
  MAINTENANCE
  NON_TEACHING
  SECURITY
  MESS_MANAGER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  MEMBER
  ADMIN
  OWNER
}

enum DocumentStatus {
  UPLOADED
  PENDING_VERIFICATION
  UNDER_REVIEW
  CORRECTION_REQUESTED
  VERIFIED
  REJECTED
  SUPERSEDED
  EXPIRED
}

enum WorkflowStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CORRECTION_REQUESTED
  ESCALATED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  identifier      String     @unique
  passwordHash    String
  name            String
  role            Role
  department      String?
  designation     String?
  phone           String?
  detail          String?
  campusIdentity  String?    @unique
  displayName     String?
  profileImageUrl String?
  status          AccountStatus? @default(ACTIVE)
  permissions     String[]   @default([])
  lastLogin       DateTime?
  isActive        Boolean    @default(true)
  activationToken String?    @unique
  resetToken      String?    @unique
  tokenExpiresAt  DateTime?
  isActivated     Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  student                  Student?
  faculty                  Faculty?
  hod                     Hod?
  userRoles               UserRole[]
  documentRecords         DocumentRecord[] @relation("DocumentOwner")
  documentVerifierQueues  DocumentRecord[] @relation("DocumentVerifier")
  uploadedDocumentVersions DocumentVersion[] @relation("DocumentVersionUploader")
  documentAuditEntries    DocumentAuditEntry[] @relation("DocumentAuditActor")
  approvalOwnerships      ApprovalWorkflow[] @relation("WorkflowOwner")
  approvalEvents          ApprovalWorkflowEvent[] @relation("ApprovalActor")
  ChatSession             ChatSession[]
  Conversation            Conversation[]
  ConversationMember      ConversationMember[]
  DirectPair_DirectPair_userHighIdToUser DirectPair[]         @relation("DirectPair_userHighIdToUser")
  DirectPair_DirectPair_userLowIdToUser  DirectPair[]         @relation("DirectPair_userLowIdToUser")
  Message                 Message[]
  MessageHidden           MessageHidden[]
  MessageReceipt          MessageReceipt[]

  @@index([identifier])
  @@index([email])
}

model DocumentRecord {
  id                    String            @id @default(cuid())
  documentId            String            @unique
  ownerUserId           String
  ownerUser             User              @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  title                 String
  category              String
  purpose               String?
  relatedEntityType     String
  relatedEntityId       String
  storageReference      String
  originalFileName      String
  version               Int               @default(1)
  status                DocumentStatus    @default(PENDING_VERIFICATION)
  currentVerifierId     String?
  currentVerifier       User?             @relation("DocumentVerifier", fields: [currentVerifierId], references: [id], onDelete: SetNull)
  reviewerDecision      String?
  reason               String?
  decisionAt           DateTime?
  expiryDate          DateTime?
  accessPolicy        String            @default("ROLE_BASED")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  versions            DocumentVersion[]
  auditEntries        DocumentAuditEntry[]
  approvalWorkflows   ApprovalWorkflow[]

  @@index([ownerUserId])
  @@index([status])
  @@index([category])
}

model DocumentVersion {
  id                String          @id @default(cuid())
  documentId        String
  document          DocumentRecord  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version           Int
  fileName          String
  storageReference  String
  uploadedByUserId  String
  uploadedByUser    User            @relation("DocumentVersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  status            DocumentStatus  @default(PENDING_VERIFICATION)
  reviewerDecision   String?
  reason            String?
  createdAt         DateTime        @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

model DocumentAuditEntry {
  id             String          @id @default(cuid())
  documentId     String
  document       DocumentRecord  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorUserId    String
  actorUser      User            @relation("DocumentAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action         String
  note           String?
  previousStatus String?
  newStatus      String?
  createdAt      DateTime        @default(now())

  @@index([documentId])
}

model ApprovalWorkflow {
  id                    String                 @id @default(cuid())
  workflowType          String
  linkedEntityType      String
  linkedEntityId        String
  currentStep           String                 @default("SUBMISSION")
  currentApproverUserId String?
  currentApproverRole   String?
  status                WorkflowStatus         @default(PENDING)
  submissionAt          DateTime               @default(now())
  decisionAt            DateTime?
  decision              String?
  reason               String?
  threshold            Int                    @default(1)
  escalationRequired   Boolean               @default(false)
  dueAt                DateTime?
  ownerUserId          String
  ownerUser            User                  @relation("WorkflowOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  documentId           String?
  document             DocumentRecord?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  events               ApprovalWorkflowEvent[]

  @@index([ownerUserId])
  @@index([status])
}

model ApprovalWorkflowEvent {
  id               String           @id @default(cuid())
  workflowId       String
  workflow         ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actorUserId      String
  actorUser        User             @relation("ApprovalActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action           String
  note             String?
  createdAt        DateTime         @default(now())

  @@index([workflowId])
}

model Student {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentId          String             @unique
  rollNumber         String             @unique
  name               String
  email              String             @unique
  personalEmail      String?
  phone              String?
  gender             String?            @default("Female")
  dob                String?            @default("15-03-2005")
  bloodGroup         String?            @default("O+")
  category           String?            @default("General")
  religion           String?            @default("Hindu")
  department         String             @default("Computer Science & Engineering")
  deptCode           String             @default("CSE")
  semester           String             @default("Semester 5")
  section            String             @default("Section A")
  academicYear       String             @default("2026-27")
  status             String             @default("Active")
  cgpa               Float              @default(8.42)
  attendance         Int                @default(92)
  walletBalance      Float              @default(1450.0)
  hostelName         String?            @default("Sarojini Girls Residence (Block A)")
  roomNumber         String?            @default("204")
  bedNumber          String?            @default("Bed 01 (Window Side)")
  floor              String?            @default("Floor 2")
  wardenName         String?            @default("Mrs. Nibedita Das")
  wardenContact      String?            @default("+91 94370 33445")
  transferConfirmed  Boolean            @default(false)
  transferCampus     String?
  transferCity       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  guardians          Guardian[]
  addresses          Address[]
  documents          Document[]
  marks              AssessmentMark[]
  attendanceRecords  AttendanceRecord[]
  biometrics         BiometricLog[]
  complaints         HostelComplaint[]
  orders             CanteenOrder[]
  programmeId        String?
  programme          Programme?         @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  enrollments        StudentEnrollment[]
  internshipCards    InternshipIdCard[]
  bonafideApplications BonafideApplication[]
  classNotes         ClassNote[]
  quizSubmissions    QuizSubmission[]

  @@index([rollNumber])
  @@index([studentId])
}

model Guardian {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String
  relationship  String
  contactNumber String?
  email         String?
}

model Address {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String   @default("Permanent")
  addressLine String
  city        String
  state       String
  country     String   @default("India")
  pincode     String
}

model Document {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category        String
  fileName        String
  fileUrl         String
  status          String   @default("Verified")
  verifiedByAdmin Boolean  @default(true)
  uploadedAt      DateTime @default(now())
}

model Faculty {
  id               String   @id @default(cuid())
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId       String   @unique
  name             String
  email            String   @unique
  phone            String?
  department       String   @default("Computer Science & Engineering")
  designation      String   @default("Associate Professor")
  assignedSubjects String[]
  assignedSections String[]
  status           String   @default("Active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courseAssignments FacultyAssignment[]
  availabilities    FacultyAvailability[]
}

model Hod {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId    String   @unique
  name          String
  email         String   @unique
  phone         String?
  department    String   @default("Computer Science & Engineering")
  deptCode      String   @default("CSE")
  experience    String   @default("18 Years")
  qualification String   @default("Ph.D in AI & Systems")
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Department {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  hod           String
  hodEmail      String
  studentsCount Int      @default(0)
  facultyCount  Int      @default(0)
  subjectsCount Int      @default(0)
  status        String   @default("Active")
}

model Semester {
  id            String   @id @default(cuid())
  number        Int      @unique
  label         String
  year          String
  academicYear  String   @default("2026-27")
  status        String   @default("Active")
  subjectsCount Int      @default(6)
  studentsCount Int      @default(540)
}

model Section {
  id                  String   @id @default(cuid())
  semester            String
  section             String
  department          String
  studentsCount       Int      @default(0)
  classRepresentative String?
  room                String?
  facultyCoordinator  String?
}

model Subject {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  department      String   @default("CSE")
  semester        String   @default("Semester 5")
  credits         Int      @default(4)
  type            String   @default("Theory + Lab")
  assignedFaculty String?
  status          String   @default("Active")
}

model MarkingScheme {
  id             String  @id @default(cuid())
  assessmentType String
  count          Int
  maxMarks       Float
  weightage      Float
  formula        String
  status         String  @default("Active")
}

model AssessmentMark {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rollNumber     String
  studentName    String
  subjectCode    String
  subjectName    String
  semester       String   @default("Semester 5")
  section        String   @default("Section A")
  modular1       Float    @default(0)
  modular2       Float    @default(0)
  quiz1          Float    @default(0)
  quiz2          Float    @default(0)
  quiz3          Float    @default(0)
  quiz4          Float    @default(0)
  quiz5          Float    @default(0)
  quiz6          Float    @default(0)
  assignment1    Float    @default(0)
  assignment2    Float    @default(0)
  surpriseTest1  Float    @default(0)
  surpriseTest2  Float    @default(0)
  labWork        Float    @default(0)
  totalMarks     Float    @default(0)
  finalWeightage Float    @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([studentId, subjectCode])
}

model ApprovalQueue {
  id            String    @id @default(cuid())
  subjectCode   String
  subject       String
  faculty       String
  semester      String
  section       String
  submittedDate String
  status        String    @default("Pending")
  hodRemarks    String?
  reviewedAt    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  user          String
  role          String
  ipAddress     String?
  status        String?  @default("Success")

  // Existing audit fields used by other modules
  targetStudent String?
  subject       String?
  assessment    String?
  oldMark       String?
  newMark       String?

  // General administrative audit fields
  action        String?
  target        String?
  oldValue      String?
  newValue      String?

  changedAt     String
  reason        String
  createdAt     DateTime @default(now())

  @@index([user])
  @@index([role])
  @@index([createdAt])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectCode String
  subjectName String
  faculty     String
  type        String   @default("Theory")
  held        Int      @default(0)
  attended    Int      @default(0)
  percentage  Float    @default(0)
}

model BiometricLog {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rollNumber String
  date       String
  time       String
  point      String
  mode       String
  direction  String
  status     String
}

model FeeStructure {
  id             String @id @default(cuid())
  term           String
  program        String
  tuitionFee     Float
  developmentFee Float
  labLibraryFee  Float
  examinationFee Float
  hostelMessFee  Float
  total          Float
}

model FeeTransaction {
  id          String   @id @default(cuid())
  studentName String
  rollNumber  String
  semester    String
  head        String
  amount      Float
  dueAmount   Float?   @default(0)
  mode        String
  date        String
  status      String   @default("Verified")
  receiptNo   String   @unique
  createdAt   DateTime @default(now())
}

model Scholarship {
  id            String @id @default(cuid())
  name          String
  authority     String
  benefit       String
  beneficiaries Int
  status        String @default("Active")
}

model Hostel {
  id            String @id @default(cuid())
  name          String
  type          String
  totalFloors   Int
  totalRooms    Int
  totalBeds     Int
  occupiedBeds  Int
  availableBeds Int
  warden        String
  contact       String
}

model HostelRoom {
  id         String @id @default(cuid())
  hostelId   String
  hostelName String
  floor      String
  roomNumber String
  capacity   Int
  occupied   Int
  type       String
}

model HostelComplaint {
  id                 String    @id @default(cuid())
  studentId          String?
  student            Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentName        String
  rollNumber         String
  hostel             String
  roomNumber         String
  category           String
  title              String
  description        String?   @db.Text
  location           String?   // Hostel, Classroom, Washroom, Laboratory, Library, etc.
  predictedCategory  String?   // plumbing, electrical, cleaning, maintenance, internet_it, other
  confidence         Float?    @default(0.0)
  needsReview        Boolean   @default(false)
  reviewReason       String?
  assignedStaffId    String?
  assignedStaffName  String?
  assignedStaffPhone String?
  assignedStaffRole  String?
  attachmentUrl      String?   @db.Text
  assignedAt         DateTime?
  resolvedAt         DateTime?
  priority           String    @default("Medium")
  status             String    @default("Pending") // Pending, Assigned, In Progress, Needs Review, Resolved, Rejected
  filedDate          String
  resolutionNotes    String?
  assignedWardenId    String?
  assignedWardenName  String?
  assignedWardenContact String?
  resolutionDeadline DateTime?
  isEscalated        Boolean   @default(false)
  escalatedAt        DateTime?
  escalationReason   String?
  workCompletedAt    DateTime?
  studentVerifiedAt  DateTime?
  reopenedAt         DateTime?
  reopenReason       String?   @db.Text
  reopenAttachmentUrl String?  @db.Text
  statusHistory      Json?
  feedbackRating     Int?
  feedbackText       String?   @db.Text
  feedbackResolved   Boolean?
  feedbackAdminComments String? @db.Text
  feedbackSubmittedAt DateTime?
  block                 String?
  floor                 String?
  preferredTime         String?
  internalNotes         String?   @db.Text
  cleaningInstructions  String?   @db.Text
  rejectionReason       String?
  resolvedBy            String?
  studentVerificationResult String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([rollNumber])
  @@index([category])
  @@index([status])
  @@index([assignedStaffId])
  @@index([assignedWardenName])
  @@index([isEscalated])
  @@index([resolutionDeadline])
}

model HostelVisitor {
  id                     String    @id @default(cuid())
  visitorName            String
  relation               String
  studentName            String
  rollNumber             String
  inTime                 String
  outTime                String?   @default("Pending Sign-out")
  passNumber             String    @unique
  purpose                String
  phone                  String?
  idProofNumber          String?
  badgeNumber            String?
  verificationCode       String?
  verificationCodeHash   String?   @map("verification_code_hash")
  visitDate              String?   @map("visit_date")
  expectedArrival        String?   @map("expected_arrival")
  actualEntry            DateTime? @map("actual_entry")
  actualExit             DateTime? @map("actual_exit")
  studentId              String?   @map("student_id")
  status                 String?   @default("Approved") // "Pre-Approved", "Checked In", "Checked Out"
  preApprovedByStudentId String?
  registeredByGuardId    String?
  hostelName             String?
  gateNumber             String?   @default("Gate 1")
  checkInTime            DateTime?
  checkOutTime           DateTime?
  visitType              String?   @default("PRE_REGISTERED") // "PRE_REGISTERED" or "WALK_IN"
  hostType               String?   @default("STUDENT") // "STUDENT" or "STAFF"
  hostUserId             String?
  hostApprovalStatus     String?   @default("APPROVED") // "PENDING_HOST_APPROVAL", "APPROVED", "REJECTED"
  hostApprovedAt         DateTime?
  hostRemarks            String?
  qrToken                String?
  createdAt              DateTime  @default(now())

  @@index([rollNumber])
  @@index([verificationCode])
  @@index([status])
}

model CampusGateMovement {
  id             String    @id @default(cuid())
  movementCode   String    @unique @default(cuid())
  eventId        String?   @map("event_id")
  passId         String    // Reference to gate pass (e.g. GP-2026-1042 or WorkflowRequest.id)
  studentId      String?   @map("student_id")
  rollNumber     String
  studentName    String
  department     String?
  hostelName     String?
  roomNumber     String?
  direction      String    // "EXIT" or "ENTRY"
  method         String?   @default("QR") // "QR" or "MANUAL"
  movementTime   DateTime  @default(now())
  gateName       String    @default("Main Campus Gate 1")
  checkpointType String?   @default("MAIN_CAMPUS") // "MAIN_CAMPUS" or "HOSTEL_GATE"
  identityType   String?   @default("STUDENT") // "STUDENT", "FACULTY", "STAFF", "VISITOR"
  qrTokenId      String?
  decisionStatus String?   @default("ENTRY_APPROVED") // "ENTRY_APPROVED", "EXIT_RECORDED", "ACCESS_DENIED", etc.
  guardId        String    @default("SEC-101")
  guardName      String    @default("Dillip Kumar Pradhan")
  status         String    @default("CONFIRMED") // "CONFIRMED" or "PROVISIONAL"
  isLate         Boolean   @default(false)
  lateDuration   String?   // e.g. "45 mins late"
  remarks        String?
  parentNotified Boolean   @default(true)
  offlineSyncId  String?   @unique
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([rollNumber])
  @@index([passId])
  @@index([direction])
  @@index([movementTime])
  @@index([status])
  @@index([checkpointType])
  @@map("campus_gate_movements")
}

model DynamicQrToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  userRole     String
  identityType String    // "STUDENT", "FACULTY", "TEACHING_STAFF", "NON_TEACHING_STAFF", "VISITOR"
  identifier   String?   // rollNumber or employeeId
  nonce        String
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  isUsed       Boolean   @default(false)
  gateId       String?
  createdAt    DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([isUsed])
  @@map("dynamic_qr_tokens")
}

model GateCheckpoint {
  id                   String    @id @default(cuid())
  gateCode             String    @unique // e.g. "GATE-01", "GATE-HOSTEL-01"
  name                 String
  type                 String    // "MAIN_CAMPUS", "HOSTEL_GATE", "ENGINEERING_BLOCK", "ACADEMIC_BLOCK", "ADMIN_BLOCK", "PERIMETER"
  assignedGuardId      String?
  assignedGuardName    String?
  currentShift         String?   @default("Morning Shift (06:00 - 14:00)")
  isOnline             Boolean   @default(true)
  allowsStudent        Boolean   @default(true)
  allowsFaculty        Boolean   @default(true)
  allowsStaff          Boolean   @default(true)
  allowsVisitor        Boolean   @default(true)
  allowsVehicle        Boolean   @default(false)
  hardwareStatus       String?   @default("Optical Turnstiles Active")
  totalMovementsToday  Int       @default(0)
  createdAt            DateTime  @default(now())

  @@map("gate_checkpoints")
}

model StudentMovementRequest {
  id                     String    @id @default(cuid())
  requestCode            String    @unique // e.g. "SMR-2026-1042"
  studentId              String
  studentRoll            String
  studentName            String
  department             String?
  hostelName             String?
  roomNumber             String?
  movementType           String    // "ROUTINE_ENTRY", "ROUTINE_EXIT", "DAY_OUT", "LEAVE", "OVERNIGHT_LEAVE", "LATE_RETURN", "EMERGENCY_LEAVE"
  reason                 String
  destination            String
  outDateTime            DateTime
  expectedInDateTime     DateTime
  actualOutDateTime      DateTime?
  actualInDateTime       DateTime?
  status                 String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "EXPIRED", "CANCELLED", "COMPLETED", "OVERDUE"
  wardenId               String?
  wardenName             String?
  wardenRemarks          String?
  parentApprovalRequired Boolean   @default(false)
  parentApproved         Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([studentRoll])
  @@index([status])
  @@index([movementType])
  @@map("student_movement_requests")
}

model OverdueReturnRecord {
  id                 String    @id @default(cuid())
  movementRequestId  String?
  studentRoll        String
  studentName        String
  hostelName         String?
  roomNumber         String?
  destination        String?
  expectedReturnTime DateTime
  actualReturnTime   DateTime?
  overdueMinutes     Int       @default(0)
  status             String    @default("OVERDUE") // "NOT_DEPARTED", "OUTSIDE_CAMPUS", "RETURNED", "OVERDUE", "APPROVED_LATE_RETURN", "NEEDS_FOLLOW_UP", "UNDER_REVIEW", "RESOLVED"
  wardenAlertSent    Boolean   @default(true)
  resolutionNotes    String?
  resolvedBy         String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([studentRoll])
  @@index([status])
  @@map("overdue_return_records")
}

model ShiftHandoverLog {
  id                     String    @id @default(cuid())
  shiftCode              String    @unique
  gateName               String
  outgoingGuardId        String
  outgoingGuardName      String
  incomingGuardId        String
