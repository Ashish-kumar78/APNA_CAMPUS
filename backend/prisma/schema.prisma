// ==============================================================================
// 1. ANONYMOUS STUDENT COMPLAINT & GRIEVANCE SYSTEM MODELS
// ==============================================================================

enum ComplaintCategory {
  TEACHING_RELATED
  FACULTY_BEHAVIOR
  COURSE_MATERIAL
  MARKS_AND_ASSESSMENTS
  CLASSROOM_ENVIRONMENT
  OTHER_ACADEMIC
}

enum ComplaintStatus {
  NEW
  UNDER_REVIEW
  RESPONSE_SUBMITTED
  AWAITING_HOD_REVIEW
  RESOLVED
  ESCALATED
}

model StudentComplaint {
  id                  String             @id @default(cuid())
  trackingId          String             @unique // e.g. CMP-2026-8492
  category            ComplaintCategory  @default(TEACHING_RELATED)
  subject             String
  description         String             @db.Text
  
  // Academic scope
  department          String             @default("Computer Science & Engineering")
  deptCode            String             @default("CSE")
  academicYear        String             @default("2026-27")
  semester            String             @default("Semester 5")
  section             String             @default("Section A")
  subjectCode         String?
  subjectName         String?
  
  // Faculty assignment relation
  facultyId           String?
  facultyName         String             // Concerned faculty member name
  
  // Attachment
  attachmentUrl       String?            @db.Text
  attachmentName      String?
  
  // Anonymity & Privacy Protection
  isAnonymous         Boolean            @default(true)
  // Protected student token/secret hash - never exposed to faculty/HOD
  studentSecretRef    String?            // Cryptographic or hashed reference for student to track their complaint
  
  // Current status
  status              ComplaintStatus    @default(NEW)
  isOverdue           Boolean            @default(false) // Flagged if unresolved > 7 days
  submittedAt         DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  
  // Responses and audit trail
  responses           ComplaintResponse[]
  statusHistory       ComplaintStatusHistory[]
  hodReviews          ComplaintHodReview[]
  
  @@index([trackingId])
  @@index([facultyName])
  @@index([deptCode])
  @@index([status])
  @@index([category])
}

model ComplaintResponse {
  id                  String             @id @default(cuid())
  complaintId         String
  complaint           StudentComplaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  
  facultyId           String?
  facultyName         String
  facultyDesignation  String?            @default("Associate Professor")
  
  responseComment     String             @db.Text
  proposedAction      String?            @db.Text // Proposed corrective actions or resolutions
  resolutionSummary   String?            @db.Text
  
  // Response timing
  responseTimeHours   Float?             @default(0.0)
  submittedAt         DateTime           @default(now())
  
  @@index([complaintId])
}

model ComplaintStatusHistory {
  id                  String             @id @default(cuid())
  complaintId         String
  complaint           StudentComplaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  
  fromStatus          ComplaintStatus
  toStatus            ComplaintStatus
  changedBy           String             // e.g. "Dr. S. Mohanty (Faculty)" or "Dr. P. K. Pattnaik (HOD)"
  changedByRole       String             // FACULTY, HOD, ADMIN
  remarks             String?            @db.Text
  timestamp           DateTime           @default(now())
  
  @@index([complaintId])
}

model ComplaintHodReview {
  id                  String             @id @default(cuid())
  complaintId         String
  complaint           StudentComplaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  
  hodId               String?
  hodName             String
  reviewOutcome       String             // "Adequate", "Clarification Requested", "Corrective Action Required", "Escalated"
  observations        String             @db.Text
  isResponseAdequate  Boolean            @default(true)
  requiresClarification Boolean          @default(false)
  requiresCorrectiveAction Boolean       @default(false)
  isEscalated         Boolean            @default(false)
  escalationReason    String?            @db.Text
  finalReviewStatus   String             @default("Reviewed")
  reviewedAt          DateTime           @default(now())
  
  @@index([complaintId])
}

// ==============================================================================
// 2. FACULTY-TO-STUDENT NOTIFICATION SYSTEM MODELS
// ==============================================================================

enum FacultyNotificationCategory {
  EXAMINATION
  EXAM_TIMETABLE
  ASSIGNMENT_DEADLINE
  INTERNAL_ASSESSMENT
  PRACTICAL_EXAM
  CLASS_CANCELLATION
  SCHEDULE_CHANGE
  EXTRA_CLASS
  PROJECT_SUBMISSION
  ACADEMIC_REMINDER
  GENERAL_ANNOUNCEMENT
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationPublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  CANCELLED
}

model FacultyNotification {
  id                  String                      @id @default(cuid())
  title               String
  message             String                      @db.Text
  category            FacultyNotificationCategory @default(GENERAL_ANNOUNCEMENT)
  priority            NotificationPriority        @default(NORMAL)
  status              NotificationPublishStatus   @default(PUBLISHED)
  
  // Faculty author details
  facultyId           String?
  facultyName         String
  facultyDesignation  String                      @default("Associate Professor")
  facultyEmail        String?
  department          String                      @default("Computer Science & Engineering")
  
  // Target Academic Scoping
  academicYear        String                      @default("2026-27")
  program             String                      @default("B.Tech")
  semester            String                      @default("Semester 5")
  section             String                      @default("Section A") // e.g. "Section A", "Section B", or "ALL_ASSIGNED"
  subjectCode         String?
  subjectName         String?
  
  // Delivery timing
  scheduledFor        DateTime?
  publishedAt         DateTime                    @default(now())
  expiresAt           DateTime?
  
  // Optional attachment
  attachmentUrl       String?                     @db.Text
  attachmentName      String?
  
  // Stats
  totalRecipients     Int                         @default(0)
  totalRead           Int                         @default(0)
  
  recipients          FacultyNotificationRecipient[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  
  @@index([facultyName])
  @@index([semester])
  @@index([section])
  @@index([subjectCode])
  @@index([status])
}

model FacultyNotificationRecipient {
  id                  String                      @id @default(cuid())
  notificationId      String
  notification        FacultyNotification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  
  studentId           String?
  studentRollNumber   String
  studentName         String
  studentEmail        String?
  semester            String
  section             String
  
  isRead              Boolean                     @default(false)
  readAt              DateTime?
  
  @@unique([notificationId, studentRollNumber])
  @@index([studentRollNumber])
  @@index([isRead])
}

enum RoomType {
  CLASSROOM
  SMART_CLASSROOM
  COMPUTER_LAB
  HARDWARE_LAB
  ELECTRONICS_LAB
  SEMINAR_HALL
  AUDITORIUM
  WORKSHOP
}

model Room {
  id                 String             @id @default(cuid())
  roomNumber         String             @unique
  building           String             @default("Main Academic Block")
  floor              String             @default("3rd Floor")
  roomType           RoomType           @default(CLASSROOM)
  capacity           Int                @default(60)
  department         String             @default("CSE")
  isLab              Boolean            @default(false)
  facilities         String[]           @default([])
  status             String             @default("Active")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  timetableEntries   TimetableEntry[]
  roomAvailabilities RoomAvailability[]

  @@index([roomNumber])
  @@index([roomType])
  @@index([department])
}

model AcademicScheduleConfig {
  id                     String   @id @default(cuid())
  academicYear           String   @default("2026-27")
  department             String   @default("CSE")
  workingDays            String[] @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"])
  periodsPerDay          Int      @default(7)
  slotTimings            Json     // array of { period: 1, startTime: "09:00 AM", endTime: "10:00 AM", isBreak: false, label: "Period 1" }
  maxConsecutiveTheory   Int      @default(3)
  maxDailyFacultyPeriods Int      @default(4)
  preferredLabDays       String[] @default(["Tuesday", "Thursday", "Friday"])
  lunchBreakPeriod       Int      @default(4)
  isDefault              Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([academicYear, department])
}

model FacultyAvailability {
  id          String   @id @default(cuid())
  facultyId   String
  faculty     Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  dayOfWeek   String   // Monday, Tuesday, ...
  periodIndex Int      // 0, 1, 2, ...
  isAvailable Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([facultyId, dayOfWeek, periodIndex])
  @@index([facultyId])
}

model RoomAvailability {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek   String
  periodIndex Int
  isAvailable Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roomId, dayOfWeek, periodIndex])
  @@index([roomId])
}

enum TimetableStatus {
  DRAFT
  VALIDATED
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

model Timetable {
  id                 String              @id @default(cuid())
  title              String
  academicYear       String              @default("2026-27")
  semester           String              @default("Semester 5")
  department         String              @default("CSE")
  programmeId        String?
  section            String              @default("Section A")
  status             TimetableStatus     @default(DRAFT)
  version            Int                 @default(1)
  isPublished        Boolean             @default(false)
  qualityScore       Float               @default(100.0)
  conflictCount      Int                 @default(0)
  solverDiagnostics  Json?
  infeasibilityNotes String?
  generationJobId    String?
  createdBy          String              @default("System / HOD")
  approvedBy         String?
  approvedAt         DateTime?
  publishedBy        String?
  publishedAt        DateTime?
  rejectionReason    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  entries            TimetableEntry[]
  conflicts          TimetableConflict[]

  @@index([academicYear, department, semester, section])
  @@index([status])
}

model TimetableEntry {
  id             String    @id @default(cuid())
  timetableId    String
  timetable      Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  dayOfWeek      String    // Monday, Tuesday, Wednesday, Thursday, Friday, Saturday
  periodIndex    Int       // 0 to periodsPerDay - 1
  startTime      String    // e.g. "09:00 AM"
  endTime        String    // e.g. "10:00 AM"
  subjectCode    String
  subjectName    String
  subjectCredits Int       @default(4)
  sessionType    String    @default("THEORY") // THEORY, LAB, PRACTICAL, SEMINAR, BREAK
  facultyId      String?
  facultyName    String?
  roomId         String?
  room           Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomNumber     String?
  section        String    @default("Section A")
  durationPeriods Int      @default(1)
  isConsecutive  Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([timetableId])
  @@index([dayOfWeek, periodIndex])
  @@index([facultyId])
  @@index([roomId])
}

model TimetableGenerationJob {
  id                  String   @id @default(cuid())
  status              String   @default("PENDING") // PENDING, VALIDATING, PREPARING, SOLVING, OPTIMIZING, COMPLETED, INFEASIBLE, FAILED
  progress            Int      @default(0) // 0 - 100
  stepName            String   @default("Initiating generation...")
  department          String
  academicYear        String
  semester            String
  section             String?
  programmeId         String?
  scope               String   @default("SECTION") // SECTION, DEPARTMENT
  constraintsConfig   Json?    // soft weights, max consecutive, preferred days, etc.
  diagnostics         Json?
  infeasibilityReport Json?
  resultTimetableId   String?
  error               String?
  initiatedBy         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([department, academicYear])
}

model TimetableConflict {
  id              String    @id @default(cuid())
  timetableId     String
  timetable       Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  conflictType    String    // FACULTY_DOUBLE_BOOKING, ROOM_DOUBLE_BOOKING, SECTION_DOUBLE_BOOKING, CAPACITY_BREACH, LAB_MISMATCH, WORKLOAD_EXCEEDED, CONSECUTIVE_LIMIT, UNSCHEDULED_REQUIREMENT
  severity        String    @default("HARD") // HARD, SOFT, WARNING
  dayOfWeek       String?
  periodIndex     Int?
  timeSlot        String?
  subjectCode     String?
  facultyName     String?
  roomNumber      String?
  section         String?
  description     String
  suggestedAction String?
  createdAt       DateTime  @default(now())

  @@index([timetableId])
}

// ==============================================================================
// 3. INTERNSHIP CELL & AUTOMATIC ID CARD GENERATION MODELS
// ==============================================================================

enum InternshipCardStatus {
  PENDING
  ISSUED
  EXPIRED
  REVOKED
}

model InternshipIdCard {
  id                 String               @id @default(cuid())
  cardNumber         String               @unique // e.g. "AC-INT-2026-0001"
  studentId          String
  student            Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Snapshot/verified details at time of issuance
  studentName        String
  registrationNo     String               // Student's roll number or studentId
  course             String               // e.g. "B.Tech Computer Science & Engineering"
  department         String               // e.g. "Computer Science & Engineering"
  batch              String               // e.g. "BTECH 2028-P"
  academicSession    String               @default("2026-2027 (SIP)")
  company            String               @default("Central Tool Room and Training Center")
  designation        String?              @default("Industrial Trainee / Intern")
  mobile             String?
  photoUrl           String?              // Base64 Data URL, SVG, or public asset path
  
  // Dates and validity
  issueDate          DateTime             @default(now())
  expiryDate         DateTime?
  status             InternshipCardStatus @default(ISSUED)
  
  // Issuance metadata
  issuedBy           String               @default("Internship Cell Coordinator")
  issuedByUserId     String?
  
  // Verification security
  verificationToken  String               @unique @default(cuid())
  qrCodeDataUrl      String?              @db.Text
  
  // Revocation details
  revokedAt          DateTime?
  revokedBy          String?
  revocationReason   String?              @db.Text
  
  // Renewal & Reissue History
  version            Int                  @default(1)
  isCurrent          Boolean              @default(true)
  previousCardId     String?
  reissueReason      String?
  history            Json?                @default("[]")
  
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([studentId])
  @@index([registrationNo])
  @@index([cardNumber])
  @@index([verificationToken])
  @@index([status])
}

// ==============================================================================
// 4. BONAFIDE CERTIFICATE MANAGEMENT SYSTEM MODELS
// ==============================================================================

enum BonafidePurpose {
  INTERNSHIP
  SCHOLARSHIP_HOSTELLER
  STUDY_LOAN
  EXTERNAL_EVENT
}

enum BonafideStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  CERTIFICATE_ISSUED
  WITHDRAWN
}

enum BonafideStage {
  STUDENT_SUBMISSION
  PLACEMENT_VERIFICATION
  SCHOLARSHIP_INITIAL_VERIFICATION
  PRINCIPAL_APPROVAL
  SCHOLARSHIP_FINAL_APPROVAL
  COMPLETED
}

model BonafideApplication {
  id                     String           @id @default(cuid())
  applicationNumber      String           @unique // e.g. "GIFT-BNF-2026-0001"
  studentId              String
  student                Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentRoll            String
  studentName            String
  purpose                BonafidePurpose
  purposeTitle           String
  academicYear           String           @default("2026-27")
  status                 BonafideStatus   @default(SUBMITTED)
  currentStage           BonafideStage    @default(STUDENT_SUBMISSION)
  currentStageLabel      String           @default("Submitted by Student")
  assignedRole           String           // "PLACEMENT", "SCHOLARSHIP", "PRINCIPAL"
  isHostellerVerified    Boolean          @default(false)
  formData               Json             // Purpose-specific fields
  supportingDocs         Json?            @default("[]")
  submissionDate         DateTime         @default(now())
  lastUpdated            DateTime         @updatedAt
  currentRevision        Int              @default(1)
  
  // Rejection / Correction fields
  rejectionReason        String?          @db.Text
  rejectionCategory      String?
  correctionInstructions String?          @db.Text
  
  // Withdrawal
  withdrawnAt            DateTime?
  withdrawalReason       String?
  
  // Relations
  certificate            BonafideCertificate?
  revisions              BonafideRevision[]
  reviews                BonafideReview[]
  auditLogs              BonafideAuditLog[]

  @@index([studentId])
  @@index([studentRoll])
  @@index([purpose])
  @@index([status])
  @@index([currentStage])
  @@index([assignedRole])
  @@map("bonafide_applications")
}

model BonafideRevision {
  id              String              @id @default(cuid())
  applicationId   String
  application     BonafideApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  revisionNumber  Int
  formData        Json
  supportingDocs  Json?               @default("[]")
  submittedAt     DateTime            @default(now())
  notes           String?             @db.Text

  @@index([applicationId])
  @@map("bonafide_revisions")
}

model BonafideReview {
  id                 String              @id @default(cuid())
  applicationId      String
  application        BonafideApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage              BonafideStage
  stageName          String
  assignedRole       String
  reviewerId         String?
  reviewerName       String
  reviewerRole       String
  action             String              // "APPROVED", "REJECTED", "CHANGES_REQUESTED"
  status             String
  remarks            String?             @db.Text
  rejectionCategory  String?
  reviewedAt         DateTime            @default(now())

  @@index([applicationId])
  @@index([stage])
  @@map("bonafide_reviews")
}

model BonafideCertificate {
  id                String              @id @default(cuid())
  certificateNumber String              @unique // e.g. "GIFT/BONAFIDE/2026/0001"
  applicationId     String              @unique
  application       BonafideApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentId         String
  purpose           BonafidePurpose
  issueDate         DateTime            @default(now())
  validUntil        DateTime?
  certificateTitle  String
  recipient         String?
  verificationToken String              @unique @default(cuid())
  qrCodeDataUrl     String?             @db.Text
  issuedBy          String              @default("Registrar / Authorized Signatory")
  issuedByRole      String              @default("REGISTRAR")
  pdfUrl            String?
  meta              Json?

  @@index([applicationId])
  @@index([verificationToken])
  @@map("bonafide_certificates")
}

model BonafideAuditLog {
  id               String              @id @default(cuid())
  applicationId    String
  application      BonafideApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action           String
  performedBy      String
  performedByRole  String
  previousStatus   String?
  newStatus        String?
  remarks          String?             @db.Text
  timestamp        DateTime            @default(now())

  @@index([applicationId])
  @@map("bonafide_audit_logs")
}

model SecurityIncident {
  id              String    @id @default(cuid())
  incidentCode    String    @unique
  title           String
  category        String
  severity        String    // low, medium, high, critical
  status          String    @default("open") // open, investigating, resolved, closed
  affectedAccount     String
  reportedByGuardId   String?   @map("reported_by_guard_id")
  reportedByGuardName String?   @map("reported_by_guard_name")
  hostelName          String?   @map("hostel_name")
  studentRoll         String?   @map("student_roll")
  location            String?   @default("Main Campus Gate 1")
  sourceIp            String?
  detectedAt      DateTime  @default(now())
  evidence        String?
  resolutionNotes String?
  assignedTo      String?
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([severity])
}

model SystemLog {
  id        String   @id @default(cuid())
  logCode   String?
  timestamp DateTime @default(now())
  level     String   // INFO, WARN, ERROR, DEBUG
  component String
  requestId String?
  message   String
  latencyMs Float?
  ipAddress String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([component])
  @@index([timestamp])
}

model UserSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique @default(cuid())
  userId       String?
  identifier   String
  name         String
  role         String
  ipAddress    String
  device       String
  loginTime    DateTime @default(now())
  expiresAt    DateTime
  status       String   @default("Active") // Active, Revoked, Expired
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([identifier])
  @@index([status])
}

model IntegrationConfig {
  id         String   @id @default(cuid())
  key        String   @unique // smtp, sms, payment, s3, ai_service, biometric
  name       String
  provider   String
  endpoint   String
  authType   String
  status     String   @default("Operational")
  latencyMs  Int      @default(20)
  lastPing   DateTime @default(now())
  lastError  String?
  configJson Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([key])
}

model BackupSnapshot {
  id              String   @id @default(cuid())
  snapshotCode    String   @unique
  fileName        String
  snapshotType    String
  size            String
  databaseVersion String   @default("PostgreSQL 16.3")
  status          String   @default("Completed")
  checksum        String
  retentionDays   Int      @default(90)
  createdAt       DateTime @default(now())

  @@index([status])
}

model AdministrativeApproval {
  id              String    @id @default(cuid())
  approvalCode    String    @unique
  title           String
  category        String
  severity        String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requesterName   String
  requesterRole   String
  requesterId     String
  requestedAt     DateTime  @default(now())
  scope           String
  justification   String
  impactStatement String?
  actionHistory   Json      @default("[]")
  decidedAt       DateTime?
  decidedBy       String?
  decisionReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

model ChatSession {
  id         String    @id
  secretHash String    @unique
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, revokedAt])
  @@index([userId, expiresAt])
}

model Conversation {
  id                 String               @id
  type               ConversationType
  title              String?
  avatarUrl          String?
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  User               User                 @relation(fields: [createdById], references: [id])
  ConversationMember ConversationMember[]
  DirectPair         DirectPair?
  Message            Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id
  conversationId String
  userId         String
  role           MemberRole   @default(MEMBER)
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?
  isFavorite     Boolean      @default(false)
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
}

model DirectPair {
  id                               String       @id
  userLowId                        String
  userHighId                       String
  conversationId                   String       @unique
  Conversation                     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User_DirectPair_userHighIdToUser User         @relation("DirectPair_userHighIdToUser", fields: [userHighId], references: [id], onDelete: Cascade)
  User_DirectPair_userLowIdToUser  User         @relation("DirectPair_userLowIdToUser", fields: [userLowId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
}

model Message {
  id                String             @id
  conversationId    String
  senderId          String
  clientMessageId   String
  body              String
  createdAt         DateTime           @default(now())
  editedAt          DateTime?
  deletedAt         DateTime?
  replyToId         String?
  Conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Message           Message?           @relation("MessageToMessage", fields: [replyToId], references: [id])
  other_Message     Message[]          @relation("MessageToMessage")
  User              User               @relation(fields: [senderId], references: [id])
  MessageAttachment MessageAttachment?
  MessageHidden     MessageHidden[]
  MessageReceipt    MessageReceipt[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([replyToId])
  @@index([senderId, createdAt])
}

model MessageAttachment {
  id        String   @id
  messageId String   @unique
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageHidden {
  id        String   @id
  messageId String
  userId    String
  createdAt DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, messageId])
}

model MessageReceipt {
  id          String    @id
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?
  Message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model face_attendance_logs {
  id           Int       @id @default(autoincrement())
  roll_number  String    @db.VarChar(50)
  student_name String    @db.VarChar(100)
  date         String    @db.VarChar(20)
  time         String    @db.VarChar(20)
  status       String?   @default("PRESENT") @db.VarChar(20)
  source       String?   @default("FACE_RECOGNITION_AI") @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([roll_number, date], map: "unique_roll_per_date")
}


model CalendarNote {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  userRole      String?   @map("user_role")
  userEmail     String?   @map("user_email")
  userName      String?   @map("user_name")
  title         String
  description   String?   @db.Text
  scheduledDate String    @map("scheduled_date")
  startTime     String?   @map("start_time")
  endTime       String?   @map("end_time")
  status        String    @default("PENDING")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([scheduledDate])
  @@map("calendar_notes")
}


model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  theme     String   @default("light")
  language  String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}


// ============================================================================
// TRANSPORT MANAGEMENT ENTERPRISE MODELS
// ============================================================================

model TransportVehicle {
  id              String   @id @default(cuid())
  busNumber       String   @unique @map("bus_number")
  fleetCode       String   @map("fleet_code")
  type            String   @default("52-Seater Coach")
  capacity        Int      @default(52)
  driver          String?
  driverPhone     String?  @map("driver_phone")
  routeName       String?  @map("route_name")
  depot           String   @default("Campus Central Bus Bay")
