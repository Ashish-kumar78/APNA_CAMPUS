datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  MANAGEMENT
  PRINCIPAL
  ADMIN
  HOD
  FACULTY
  STUDENT
  EXAM_CELL
  ACCOUNTS
  LIBRARY
  PLACEMENT
  TRANSPORT
  HOSTEL
  STAFF
  WARDEN
  CANTEEN
  ADMISSIONS
  MAINTENANCE
  NON_TEACHING
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  identifier      String     @unique
  passwordHash    String
  name            String
  role            Role
  department      String?
  designation     String?
  phone           String?
  detail          String?
  permissions     String[]   @default([])
  lastLogin       DateTime?
  isActive        Boolean    @default(true)
  activationToken String?    @unique
  resetToken      String?    @unique
  tokenExpiresAt  DateTime?
  isActivated     Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  student         Student?
  faculty         Faculty?
  hod             Hod?
  userRoles       UserRole[]

  @@index([identifier])
  @@index([email])
}

model Student {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentId          String             @unique
  rollNumber         String             @unique
  name               String
  email              String             @unique
  phone              String?
  gender             String?            @default("Female")
  dob                String?            @default("15-03-2005")
  bloodGroup         String?            @default("O+")
  category           String?            @default("General")
  religion           String?            @default("Hindu")
  department         String             @default("Computer Science & Engineering")
  deptCode           String             @default("CSE")
  semester           String             @default("Semester 5")
  section            String             @default("Section A")
  academicYear       String             @default("2026-27")
  status             String             @default("Active")
  cgpa               Float              @default(8.42)
  attendance         Int                @default(92)
  walletBalance      Float              @default(1450.0)
  hostelName         String?            @default("Sarojini Girls Residence (Block A)")
  roomNumber         String?            @default("204")
  bedNumber          String?            @default("Bed 01 (Window Side)")
  floor              String?            @default("Floor 2")
  wardenName         String?            @default("Mrs. Nibedita Das")
  wardenContact      String?            @default("+91 94370 33445")
  transferConfirmed  Boolean            @default(false)
  transferCampus     String?
  transferCity       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  guardians          Guardian[]
  addresses          Address[]
  documents          Document[]
  marks              AssessmentMark[]
  attendanceRecords  AttendanceRecord[]
  biometrics         BiometricLog[]
  complaints         HostelComplaint[]
  orders             CanteenOrder[]
  programmeId        String?
  programme          Programme?         @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  enrollments        StudentEnrollment[]

  @@index([rollNumber])
  @@index([studentId])
}

model Guardian {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String
  relationship  String
  contactNumber String?
  email         String?
}

model Address {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String   @default("Permanent")
  addressLine String
  city        String
  state       String
  country     String   @default("India")
  pincode     String
}

model Document {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category        String
  fileName        String
  fileUrl         String
  status          String   @default("Verified")
  verifiedByAdmin Boolean  @default(true)
  uploadedAt      DateTime @default(now())
}

model Faculty {
  id               String   @id @default(cuid())
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId       String   @unique
  name             String
  email            String   @unique
  phone            String?
  department       String   @default("Computer Science & Engineering")
  designation      String   @default("Associate Professor")
  assignedSubjects String[]
  assignedSections String[]
  status           String   @default("Active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courseAssignments FacultyAssignment[]
  availabilities    FacultyAvailability[]
}

model Hod {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId    String   @unique
  name          String
  email         String   @unique
  phone         String?
  department    String   @default("Computer Science & Engineering")
  deptCode      String   @default("CSE")
  experience    String   @default("18 Years")
  qualification String   @default("Ph.D in AI & Systems")
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Department {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  hod           String
  hodEmail      String
  studentsCount Int      @default(0)
  facultyCount  Int      @default(0)
  subjectsCount Int      @default(0)
  status        String   @default("Active")
}

model Semester {
  id            String   @id @default(cuid())
  number        Int      @unique
  label         String
  year          String
  academicYear  String   @default("2026-27")
  status        String   @default("Active")
  subjectsCount Int      @default(6)
  studentsCount Int      @default(540)
}

model Section {
  id                  String   @id @default(cuid())
  semester            String
  section             String
  department          String
  studentsCount       Int      @default(0)
  classRepresentative String?
  room                String?
  facultyCoordinator  String?
}

model Subject {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  department      String   @default("CSE")
  semester        String   @default("Semester 5")
  credits         Int      @default(4)
  type            String   @default("Theory + Lab")
  assignedFaculty String?
  status          String   @default("Active")
}

model MarkingScheme {
  id             String  @id @default(cuid())
  assessmentType String
  count          Int
  maxMarks       Float
  weightage      Float
  formula        String
  status         String  @default("Active")
}

model AssessmentMark {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rollNumber     String
  studentName    String
  subjectCode    String
  subjectName    String
  semester       String   @default("Semester 5")
  section        String   @default("Section A")
  modular1       Float    @default(0)
  modular2       Float    @default(0)
  quiz1          Float    @default(0)
  quiz2          Float    @default(0)
  quiz3          Float    @default(0)
  quiz4          Float    @default(0)
  quiz5          Float    @default(0)
  quiz6          Float    @default(0)
  assignment1    Float    @default(0)
  assignment2    Float    @default(0)
  surpriseTest1  Float    @default(0)
  surpriseTest2  Float    @default(0)
  labWork        Float    @default(0)
  totalMarks     Float    @default(0)
  finalWeightage Float    @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([studentId, subjectCode])
}

model ApprovalQueue {
  id            String    @id @default(cuid())
  subjectCode   String
  subject       String
  faculty       String
  semester      String
  section       String
  submittedDate String
  status        String    @default("Pending")
  hodRemarks    String?
  reviewedAt    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  user          String
  role          String
  targetStudent String?
  subject       String?
  assessment    String?
  oldMark       String?
  newMark       String?
  changedAt     String
  reason        String
  createdAt     DateTime @default(now())
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectCode String
  subjectName String
  faculty     String
  type        String   @default("Theory")
  held        Int      @default(0)
  attended    Int      @default(0)
  percentage  Float    @default(0)
}

model BiometricLog {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rollNumber String
  date       String
  time       String
  point      String
  mode       String
  direction  String
  status     String
}

model FeeStructure {
  id             String @id @default(cuid())
  term           String
  program        String
  tuitionFee     Float
  developmentFee Float
  labLibraryFee  Float
  examinationFee Float
  hostelMessFee  Float
  total          Float
}

model FeeTransaction {
  id          String   @id @default(cuid())
  studentName String
  rollNumber  String
  semester    String
  head        String
  amount      Float
  dueAmount   Float?   @default(0)
  mode        String
  date        String
  status      String   @default("Verified")
  receiptNo   String   @unique
  createdAt   DateTime @default(now())
}

model Scholarship {
  id            String @id @default(cuid())
  name          String
  authority     String
  benefit       String
  beneficiaries Int
  status        String @default("Active")
}

model Hostel {
  id            String @id @default(cuid())
  name          String
  type          String
  totalFloors   Int
  totalRooms    Int
  totalBeds     Int
  occupiedBeds  Int
  availableBeds Int
  warden        String
  contact       String
}

model HostelRoom {
  id         String @id @default(cuid())
  hostelId   String
  hostelName String
  floor      String
  roomNumber String
  capacity   Int
  occupied   Int
  type       String
}

model HostelComplaint {
  id                 String    @id @default(cuid())
  studentId          String?
  student            Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentName        String
  rollNumber         String
  hostel             String
  roomNumber         String
  category           String
  title              String
  description        String?   @db.Text
  location           String?   // Hostel, Classroom, Washroom, Laboratory, Library, etc.
  predictedCategory  String?   // plumbing, electrical, cleaning, maintenance, internet_it, other
  confidence         Float?    @default(0.0)
  needsReview        Boolean   @default(false)
  reviewReason       String?
  assignedStaffId    String?
  assignedStaffName  String?
  assignedStaffPhone String?
  assignedStaffRole  String?
  attachmentUrl      String?   @db.Text
  assignedAt         DateTime?
  resolvedAt         DateTime?
  priority           String    @default("Medium")
  status             String    @default("Pending") // Pending, Assigned, In Progress, Needs Review, Resolved, Rejected
  filedDate          String
  resolutionNotes    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([rollNumber])
  @@index([category])
  @@index([status])
  @@index([assignedStaffId])
}

model HostelVisitor {
  id          String   @id @default(cuid())
  visitorName String
  relation    String
  studentName String
  rollNumber  String
  inTime      String
  outTime     String?  @default("Pending Sign-out")
  passNumber  String   @unique
  purpose     String
  createdAt   DateTime @default(now())
}

model FoodItem {
  id          String  @id @default(cuid())
  name        String
  category    String
  price       Float
  isAvailable Boolean @default(true)
  prepTime    String
  calories    String
}

model CanteenOrder {
  id          String   @id @default(cuid())
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentName String
  rollNumber  String
  items       Json
  totalAmount Float
  status      String   @default("Pending")
  paymentMode String   @default("RFID Smart Card")
  orderedAt   String
  token       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffRoster {
  id                  String   @id @default(cuid())
  staffType           String   // WARDEN, SECURITY, CANTEEN, SUPPORT
  name                String
  gender              String?
  roleOrCategory      String?
  outletOrZone        String?
  assignedHostelOrPost String?
  roomOffice          String?
  phone               String
  email               String?
  shift               String
  badgeNumber         String?
  fssaiLicense        String?
  emergencyContact    String?
  speciality          String?
  qualification       String?
  assignedAgency      String?
  bloodGroup          String?
  residentsCount      Int?
  totalBeds           Int?
  status              String   @default("Active")
  joiningYear         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Notice {
  id         String   @id @default(cuid())
  title      String
  tag        String
  date       String
  publisher  String
  pinned     Boolean  @default(false)
  summary    String
  content    String
  attachment String?
  createdAt  DateTime @default(now())
}

model BlogPost {
  id         String   @id @default(cuid())
  author     String
  dept       String
  initials   String
  date       String
  tag        String
  title      String
  body       String
  likes      Int      @default(0)
  comments   Int      @default(0)
  bookmarked Boolean  @default(false)
  liked      Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model FeedbackSurvey {
  id          String   @id @default(cuid())
  formType    String
  targetId    String?
  targetName  String?
  rating      Int
  comments    String?
  studentId   String?
  submittedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  role      String
  title     String
  message   String
  time      String
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Holiday {
  id        String @id @default(cuid())
  rawDate   String
  name      String
  daysLeft  Int?
}

model ExamSchedule {
  id              String   @id @default(cuid())
  examCode        String   @unique
  title           String
  semester        String
  department      String   @default("All Departments")
  session         String   @default("Morning (10:00 AM - 01:00 PM)")
  startDate       String
  endDate         String
  status          String   @default("Scheduled")
  totalAppeared   Int      @default(0)
  passPercentage  Float    @default(0)
  hallTicketLive  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LibraryBook {
  id              String   @id @default(cuid())
  isbn            String   @unique
  title           String
  author          String
  department      String   @default("General")
  category        String   @default("Textbook")
  totalCopies     Int      @default(5)
  availableCopies Int      @default(5)
  shelfLocation   String   @default("Stack A-1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LibraryTransaction {
  id          String   @id @default(cuid())
  bookId      String
  bookTitle   String
  studentRoll String
  studentName String
  issueDate   String
  dueDate     String
  returnDate  String?
  fineAmount  Float    @default(0)
  status      String   @default("Issued")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlacementDrive {
  id               String   @id @default(cuid())
  companyName      String
  roleTitle        String
  packageLPA       Float
  minCgpa          Float    @default(6.5)
  eligibleBranches String[]
  driveDate        String
  venue            String   @default("Auditorium / Online")
  registeredCount  Int      @default(0)
  shortlistedCount Int      @default(0)
  selectedCount    Int      @default(0)
  status           String   @default("Open")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PlacementApplication {
  id          String   @id @default(cuid())
  driveId     String
  companyName String
  studentRoll String
  studentName String
  cgpa        Float
  status      String   @default("Applied")
  appliedAt   DateTime @default(now())
}

model TransportRoute {
  id             String   @id @default(cuid())
  routeNumber    String   @unique
  routeName      String
  busNumber      String
  driverName     String
  driverContact  String
  totalCapacity  Int      @default(45)
  allocatedCount Int      @default(0)
  departureTime  String   @default("07:15 AM")
  stops          String[]
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LabEquipment {
  id            String   @id @default(cuid())
  equipmentCode String   @unique
  equipmentName String
  labName       String
  department    String
  condition     String   @default("Operational")
  lastServiced  String
  inCharge      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("General")
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model WorkflowRequest {
  id             String   @id @default(cuid())
  workflowType   String
  title          String
  requesterId    String
  requesterName  String
  requesterRole  String
  department     String?
  details        Json
  currentStage   String
  status         String   @default("Pending")
  approverId     String?
  approverName   String?
  approvalNotes  String?
  history        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Institution {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  tagline      String?
  address      String?
  website      String?
  phone        String?
  email        String?
  affiliations String[] @default([])
  campuses     Campus[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Campus {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code          String      @unique
  name          String
  city          String
  state         String
  isMainCampus  Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Programme {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  degreeType      String              @default("UG")
  departmentCode  String              @default("CSE")
  durationYears   Int                 @default(4)
  totalSemesters  Int                 @default(8)
  creditsRequired Int                 @default(160)
  status          String              @default("Active")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  students        Student[]
  enrollments     StudentEnrollment[]
  applicants      Applicant[]
  courseOfferings CourseOffering[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  year      String   @unique
  startDate String?
  endDate   String?
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum ApplicantStatus {
  APPLIED
  VERIFIED
  APPROVED
  REJECTED
  ENROLLED
}

model Applicant {
  id                   String          @id @default(cuid())
  applicationNo        String          @unique
  name                 String
  email                String
  phone                String
  gender               String          @default("Not Specified")
  dob                  String?
  category             String          @default("General")
  programmeId          String?
  programme            Programme?      @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  programmeName        String
  academicYear         String          @default("2026-27")
  tenthMarks           Float?
  twelfthMarks         Float?
  entranceExam         String?
  entranceRank         Int?
  status               ApplicantStatus @default(APPLIED)
  stage                String?         @default("SUBMITTED")
  meritScore           Float?
  feeAmount            Float?          @default(40000)
  feePaid              Float?          @default(0)
  feeStatus            String?         @default("Pending")
  feeReceiptRef        String?
  feeConfirmedBy       String?
  feeConfirmedAt       DateTime?
  address              String?
  city                 String?
  state                String?
  guardianName         String?
  guardianPhone        String?
  previousSchool       String?
  verifiedBy           String?
  approvedBy           String?
  assignedReviewer     String?
  reviewNotes          String?
  rejectionReason      String?
  offerLetterGenerated Boolean?        @default(false)
  offerValidUntil      String?
  offerAcceptedAt      DateTime?
  documents            Json?           @default("[]")
  history              Json?           @default("[]")
  studentId            String?
  enrolledUserId       String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([applicationNo])
  @@index([status])
}

model AdmissionDeadline {
  id            String   @id @default(cuid())
  title         String
  category      String   @default("General")
  programmeCode String   @default("All")
  deadlineDate  String
  time          String   @default("05:00 PM")
  description   String?
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([deadlineDate])
}

model StudentEnrollment {
  id             String     @id @default(cuid())
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programmeId    String?
  programme      Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  academicYear   String     @default("2026-27")
  semester       String
  section        String     @default("Section A")
  status         String     @default("Enrolled")
  sgpa           Float?
  cgpa           Float?
  attendanceRate Float?
  enrolledAt     DateTime   @default(now())
  promotedAt     DateTime?

  @@index([studentId])
  @@index([academicYear])
  @@index([semester])
}

model CourseOffering {
  id           String     @id @default(cuid())
  subjectCode  String
  subjectName  String
  programmeId  String?
  programme    Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  department   String     @default("CSE")
  semester     String     @default("Semester 5")
  academicYear String     @default("2026-27")
  credits      Int        @default(4)
  type         String     @default("Theory + Lab")
  status       String     @default("Active")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  facultyAssignments FacultyAssignment[]

  @@unique([subjectCode, academicYear, semester])
}

model FacultyAssignment {
  id               String         @id @default(cuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  facultyId        String
  faculty          Faculty        @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  section          String         @default("Section A")
  academicYear     String         @default("2026-27")
  role             String         @default("Lead Instructor")
  allocatedHours   Int            @default(4)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([courseOfferingId, facultyId, section])
}

model Permission {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  module      String
  description String?
  userRoles   UserRole[]
}

model UserRole {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role
  department   String?
  permissionId String?
  permission   Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([role])
}

// ==============================================================================
// 1. ANONYMOUS STUDENT COMPLAINT & GRIEVANCE SYSTEM MODELS
// ==============================================================================

enum ComplaintCategory {
  TEACHING_RELATED
  FACULTY_BEHAVIOR
  COURSE_MATERIAL
  MARKS_AND_ASSESSMENTS
  CLASSROOM_ENVIRONMENT
  OTHER_ACADEMIC
}

enum ComplaintStatus {
  NEW
  UNDER_REVIEW
  RESPONSE_SUBMITTED
  AWAITING_HOD_REVIEW
  RESOLVED
  ESCALATED
}

model StudentComplaint {
  id                  String             @id @default(cuid())
  trackingId          String             @unique // e.g. CMP-2026-8492
  category            ComplaintCategory  @default(TEACHING_RELATED)
  subject             String
  description         String             @db.Text
  
  // Academic scope
  department          String             @default("Computer Science & Engineering")
  deptCode            String             @default("CSE")
  academicYear        String             @default("2026-27")
  semester            String             @default("Semester 5")
  section             String             @default("Section A")
  subjectCode         String?
  subjectName         String?
  
  // Faculty assignment relation
  facultyId           String?
  facultyName         String             // Concerned faculty member name
  
  // Attachment
  attachmentUrl       String?            @db.Text
  attachmentName      String?
  
  // Anonymity & Privacy Protection
  isAnonymous         Boolean            @default(true)
  // Protected student token/secret hash - never exposed to faculty/HOD
  studentSecretRef    String?            // Cryptographic or hashed reference for student to track their complaint
  
  // Current status
  status              ComplaintStatus    @default(NEW)
  isOverdue           Boolean            @default(false) // Flagged if unresolved > 7 days
  submittedAt         DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  
  // Responses and audit trail
  responses           ComplaintResponse[]
  statusHistory       ComplaintStatusHistory[]
  hodReviews          ComplaintHodReview[]
  
  @@index([trackingId])
  @@index([facultyName])
  @@index([deptCode])
  @@index([status])
  @@index([category])
}

model ComplaintResponse {
  id                  String             @id @default(cuid())
  complaintId         String
  complaint           StudentComplaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  
  facultyId           String?
  facultyName         String
  facultyDesignation  String?            @default("Associate Professor")
  
  responseComment     String             @db.Text
  proposedAction      String?            @db.Text // Proposed corrective actions or resolutions
  resolutionSummary   String?            @db.Text
  
  // Response timing
  responseTimeHours   Float?             @default(0.0)
  submittedAt         DateTime           @default(now())
  
  @@index([complaintId])
}

model ComplaintStatusHistory {
  id                  String             @id @default(cuid())
  complaintId         String
  complaint           StudentComplaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  
  fromStatus          ComplaintStatus
  toStatus            ComplaintStatus
  changedBy           String             // e.g. "Dr. S. Mohanty (Faculty)" or "Dr. P. K. Pattnaik (HOD)"
  changedByRole       String             // FACULTY, HOD, ADMIN
  remarks             String?            @db.Text
  timestamp           DateTime           @default(now())
  
  @@index([complaintId])
}

model ComplaintHodReview {
  id                  String             @id @default(cuid())
  complaintId         String
  complaint           StudentComplaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  
  hodId               String?
  hodName             String
  reviewOutcome       String             // "Adequate", "Clarification Requested", "Corrective Action Required", "Escalated"
  observations        String             @db.Text
  isResponseAdequate  Boolean            @default(true)
  requiresClarification Boolean          @default(false)
  requiresCorrectiveAction Boolean       @default(false)
  isEscalated         Boolean            @default(false)
  escalationReason    String?            @db.Text
  finalReviewStatus   String             @default("Reviewed")
  reviewedAt          DateTime           @default(now())
  
  @@index([complaintId])
}

// ==============================================================================
// 2. FACULTY-TO-STUDENT NOTIFICATION SYSTEM MODELS
// ==============================================================================

enum FacultyNotificationCategory {
  EXAMINATION
  EXAM_TIMETABLE
  ASSIGNMENT_DEADLINE
  INTERNAL_ASSESSMENT
  PRACTICAL_EXAM
  CLASS_CANCELLATION
  SCHEDULE_CHANGE
  EXTRA_CLASS
  PROJECT_SUBMISSION
  ACADEMIC_REMINDER
  GENERAL_ANNOUNCEMENT
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationPublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  CANCELLED
}

model FacultyNotification {
  id                  String                      @id @default(cuid())
  title               String
  message             String                      @db.Text
  category            FacultyNotificationCategory @default(GENERAL_ANNOUNCEMENT)
  priority            NotificationPriority        @default(NORMAL)
  status              NotificationPublishStatus   @default(PUBLISHED)
  
  // Faculty author details
  facultyId           String?
  facultyName         String
  facultyDesignation  String                      @default("Associate Professor")
  facultyEmail        String?
  department          String                      @default("Computer Science & Engineering")
  
  // Target Academic Scoping
  academicYear        String                      @default("2026-27")
  program             String                      @default("B.Tech")
  semester            String                      @default("Semester 5")
  section             String                      @default("Section A") // e.g. "Section A", "Section B", or "ALL_ASSIGNED"
  subjectCode         String?
  subjectName         String?
  
  // Delivery timing
  scheduledFor        DateTime?
  publishedAt         DateTime                    @default(now())
  expiresAt           DateTime?
  
  // Optional attachment
  attachmentUrl       String?                     @db.Text
  attachmentName      String?
  
  // Stats
  totalRecipients     Int                         @default(0)
  totalRead           Int                         @default(0)
  
  recipients          FacultyNotificationRecipient[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  
  @@index([facultyName])
  @@index([semester])
  @@index([section])
  @@index([subjectCode])
  @@index([status])
}

model FacultyNotificationRecipient {
  id                  String                      @id @default(cuid())
  notificationId      String
  notification        FacultyNotification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  
  studentId           String?
  studentRollNumber   String
  studentName         String
  studentEmail        String?
  semester            String
  section             String
  
  isRead              Boolean                     @default(false)
  readAt              DateTime?
  
  @@unique([notificationId, studentRollNumber])
  @@index([studentRollNumber])
  @@index([isRead])
}

enum RoomType {
  CLASSROOM
  SMART_CLASSROOM
  COMPUTER_LAB
  HARDWARE_LAB
  ELECTRONICS_LAB
  SEMINAR_HALL
  AUDITORIUM
  WORKSHOP
}

model Room {
  id                 String             @id @default(cuid())
  roomNumber         String             @unique
  building           String             @default("Main Academic Block")
  floor              String             @default("3rd Floor")
  roomType           RoomType           @default(CLASSROOM)
  capacity           Int                @default(60)
  department         String             @default("CSE")
  isLab              Boolean            @default(false)
  facilities         String[]           @default([])
  status             String             @default("Active")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  timetableEntries   TimetableEntry[]
  roomAvailabilities RoomAvailability[]

  @@index([roomNumber])
  @@index([roomType])
  @@index([department])
}

model AcademicScheduleConfig {
  id                     String   @id @default(cuid())
  academicYear           String   @default("2026-27")
  department             String   @default("CSE")
  workingDays            String[] @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"])
  periodsPerDay          Int      @default(7)
  slotTimings            Json
  maxConsecutiveTheory   Int      @default(3)
  maxDailyFacultyPeriods Int      @default(4)
  preferredLabDays       String[] @default(["Tuesday", "Thursday", "Friday"])
  lunchBreakPeriod       Int      @default(4)
  isDefault              Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([academicYear, department])
}

model FacultyAvailability {
  id          String   @id @default(cuid())
  facultyId   String
  faculty     Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  dayOfWeek   String
  periodIndex Int
  isAvailable Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([facultyId, dayOfWeek, periodIndex])
  @@index([facultyId])
}

model RoomAvailability {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek   String
  periodIndex Int
  isAvailable Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roomId, dayOfWeek, periodIndex])
  @@index([roomId])
}

enum TimetableStatus {
  DRAFT
  VALIDATED
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

model Timetable {
  id                 String              @id @default(cuid())
  title              String
  academicYear       String              @default("2026-27")
  semester           String              @default("Semester 5")
  department         String              @default("CSE")
  programmeId        String?
  section            String              @default("Section A")
  status             TimetableStatus     @default(DRAFT)
  version            Int                 @default(1)
  isPublished        Boolean             @default(false)
  qualityScore       Float               @default(100.0)
  conflictCount      Int                 @default(0)
  solverDiagnostics  Json?
  infeasibilityNotes String?
  generationJobId    String?
  createdBy          String              @default("System / HOD")
  approvedBy         String?
  approvedAt         DateTime?
  publishedBy        String?
  publishedAt        DateTime?
  rejectionReason    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  entries            TimetableEntry[]
  conflicts          TimetableConflict[]

  @@index([academicYear, department, semester, section])
  @@index([status])
}

model TimetableEntry {
  id             String    @id @default(cuid())
  timetableId    String
  timetable      Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  dayOfWeek      String
  periodIndex    Int
  startTime      String
  endTime        String
  subjectCode    String
  subjectName    String
  subjectCredits Int       @default(4)
  sessionType    String    @default("THEORY")
  facultyId      String?
  facultyName    String?
  roomId         String?
  room           Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomNumber     String?
  section        String    @default("Section A")
  durationPeriods Int      @default(1)
  isConsecutive  Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([timetableId])
  @@index([dayOfWeek, periodIndex])
  @@index([facultyId])
  @@index([roomId])
}

model TimetableGenerationJob {
  id                  String   @id @default(cuid())
  status              String   @default("PENDING")
  progress            Int      @default(0)
  stepName            String   @default("Initiating generation...")
  department          String
  academicYear        String
  semester            String
  section             String?
  programmeId         String?
  scope               String   @default("SECTION")
  constraintsConfig   Json?
  diagnostics         Json?
  infeasibilityReport Json?
  resultTimetableId   String?
  error               String?
  initiatedBy         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([department, academicYear])
}

model TimetableConflict {
  id              String    @id @default(cuid())
  timetableId     String
  timetable       Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  conflictType    String
  severity        String    @default("HARD")
  dayOfWeek       String?
  periodIndex     Int?
  timeSlot        String?
  subjectCode     String?
  facultyName     String?
  roomNumber      String?
  section         String?
  description     String
  suggestedAction String?
  createdAt       DateTime  @default(now())

  @@index([timetableId])
}



